// SpeakDeck injector — PPT 等比缩放 + 演讲模式 + 翻页自动播音
// 默认：字幕隐藏、音频静音；点击右下角按钮开启
(function () {

  // ── 滚动条全程隐藏 ─────────────────────────────────────
  var scrollStyle = document.createElement("style");
  scrollStyle.textContent = [
    "html, body { scrollbar-width: none; -ms-overflow-style: none; }",
    "html::-webkit-scrollbar, body::-webkit-scrollbar { width: 0; height: 0; background: transparent; }",
    "*::-webkit-scrollbar { width: 0; height: 0; background: transparent; }"
  ].join("\n");
  document.head.appendChild(scrollStyle);

  // ── PPT 等比缩放 ────────────────────────────────────────
  // 设计基准尺寸（与原 HTML 的大屏设计一致）
  var REF_W = 1440, REF_H = 900;

  function applyScale() {
    var scale = Math.min(window.innerWidth / REF_W, window.innerHeight / REF_H);
    // 让 .deck-slide 成为居中容器
    document.querySelectorAll(".deck-slide").forEach(function (ds) {
      ds.style.display = "flex";
      ds.style.alignItems = "center";
      ds.style.justifyContent = "center";
      ds.style.height = "100vh";
      ds.style.overflow = "hidden";
    });
    // 把每页内容等比缩放，像 PPT 一样
    document.querySelectorAll(".deck-slide .slide").forEach(function (el) {
      el.style.width = REF_W + "px";
      el.style.height = REF_H + "px";
      el.style.minHeight = "unset";
      el.style.flexShrink = "0";
      el.style.transform = "scale(" + scale + ")";
      el.style.transformOrigin = "center center";
    });
  }

  applyScale();
  window.addEventListener("resize", applyScale);

  // ── 演讲模式 ────────────────────────────────────────────
  // 收集所有页
  var slides = document.querySelectorAll("[data-script],[data-audio]");
  if (slides.length === 0) slides = document.querySelectorAll(".slide,section");
  if (slides.length === 0) return;

  var current = 0;
  var enabled = false; // 总开关：字幕 + 声音

  // 字幕浮层（默认隐藏）
  var speaker = document.getElementById("speaker");
  if (!speaker) {
    speaker = document.createElement("aside");
    speaker.id = "speaker";
    Object.assign(speaker.style, {
      position: "fixed", right: "24px", bottom: "80px",
      maxWidth: "360px", maxHeight: "40vh", overflowY: "auto",
      background: "rgba(22,27,34,.96)", color: "#E6EDF3",
      padding: "16px 20px", borderRadius: "12px",
      fontSize: "13px", lineHeight: "1.6", zIndex: "9998",
      boxShadow: "0 8px 32px rgba(0,0,0,.4)", display: "none"
    });
    document.body.appendChild(speaker);
  } else {
    speaker.style.display = "none";
  }

  // 音频播放器
  var audio = new Audio();

  // 右下角按钮容器（横向排列：音频开关 + 全屏）
  var btnGroup = document.createElement("div");
  Object.assign(btnGroup.style, {
    position: "fixed", right: "24px", bottom: "24px",
    display: "flex", gap: "10px", zIndex: "9999"
  });
  document.body.appendChild(btnGroup);

  var BTN_STYLE = {
    width: "48px", height: "48px", borderRadius: "50%",
    border: "none", cursor: "pointer",
    fontSize: "20px", background: "rgba(22,27,34,.85)",
    color: "rgba(255,255,255,.55)",
    boxShadow: "0 4px 16px rgba(0,0,0,.4)",
    backdropFilter: "blur(12px)", transition: "background .2s, color .2s, transform .15s",
    display: "flex", alignItems: "center", justifyContent: "center"
  };

  // 音频/字幕开关按钮
  var btn = document.createElement("button");
  btn.id = "speakdeck-toggle";
  btn.title = "字幕和声音 (P)";
  Object.assign(btn.style, BTN_STYLE);
  btn.innerHTML = "🔇";
  btnGroup.appendChild(btn);

  // 全屏播放按钮
  var fsBtn = document.createElement("button");
  fsBtn.id = "speakdeck-fullscreen";
  fsBtn.title = "全屏播放 (F)";
  Object.assign(fsBtn.style, BTN_STYLE);
  fsBtn.innerHTML = "⛶";
  fsBtn.style.fontSize = "22px";
  btnGroup.appendChild(fsBtn);

  // 键盘提示
  var hint = document.createElement("div");
  Object.assign(hint.style, {
    position: "fixed", left: "24px", bottom: "24px",
    fontSize: "11px", color: "rgba(255,255,255,.3)", zIndex: "9998",
    letterSpacing: "0.05em"
  });
  hint.textContent = "↑↓ 翻页 · P 字幕/声音 · F 全屏";
  document.body.appendChild(hint);

  // 全屏切换
  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      (document.documentElement.requestFullscreen || document.documentElement.webkitRequestFullscreen).call(document.documentElement);
    } else {
      (document.exitFullscreen || document.webkitExitFullscreen).call(document);
    }
  }
  function updateFsBtn() {
    var isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
    fsBtn.innerHTML = isFs ? "⛗" : "⛶";
    fsBtn.title = isFs ? "退出全屏 (F / Esc)" : "全屏播放 (F)";
    fsBtn.style.background = isFs ? "rgba(79,182,255,.25)" : "rgba(22,27,34,.85)";
    fsBtn.style.color = isFs ? "#fff" : "rgba(255,255,255,.55)";
  }
  fsBtn.addEventListener("click", toggleFullscreen);
  document.addEventListener("fullscreenchange", updateFsBtn);
  document.addEventListener("webkitfullscreenchange", updateFsBtn);

  function setEnabled(on) {
    enabled = on;
    btn.innerHTML = on ? "🔊" : "🔇";
    btn.style.color = on ? "#fff" : "rgba(255,255,255,.45)";
    btn.style.background = on ? "rgba(79,182,255,.25)" : "rgba(22,27,34,.85)";
    speaker.style.display = on ? "" : "none";
    if (on) playCurrent(); else audio.pause();
  }

  function playCurrent() {
    var el = slides[current];
    if (!el) return;
    speaker.textContent = el.dataset.script || "";
    if (!enabled) return;
    var src = el.dataset.audio;
    if (src) { audio.src = src; audio.play().catch(function(){}); }
    else audio.pause();
  }

  function goTo(idx) {
    if (idx < 0 || idx >= slides.length) return;
    current = idx;
    slides[idx].scrollIntoView({ behavior: "smooth" });
    playCurrent();
  }

  btn.addEventListener("click", function () { setEnabled(!enabled); });

  // IntersectionObserver：滚动时同步 current
  var io = new IntersectionObserver(function (entries) {
    var best = null;
    entries.forEach(function (e) {
      if (e.isIntersecting && (!best || e.intersectionRatio > best.intersectionRatio)) best = e;
    });
    if (!best) return;
    var idx = Array.from(slides).indexOf(best.target);
    if (idx === current) return;
    current = idx;
    speaker.textContent = (slides[idx].dataset.script) || "";
    if (enabled) {
      var src = slides[idx].dataset.audio;
      if (src) { audio.src = src; audio.play().catch(function(){}); }
    }
  }, { threshold: [0.5, 0.8] });
  slides.forEach(function (s) { io.observe(s); });

  // 键盘控制
  document.addEventListener("keydown", function (e) {
    if (e.key === "p" || e.key === "P") {
      setEnabled(!enabled);
    } else if (e.key === "ArrowDown" || e.key === "PageDown" || e.key === " ") {
      e.preventDefault(); goTo(current + 1);
    } else if (e.key === "ArrowUp" || e.key === "PageUp") {
      e.preventDefault(); goTo(current - 1);
    } else if (e.key === "m" || e.key === "M") {
      if (enabled) { audio.paused ? audio.play().catch(function(){}) : audio.pause(); }
    } else if (e.key === "r" || e.key === "R") {
      if (enabled) { audio.currentTime = 0; audio.play().catch(function(){}); }
    } else if (e.key === "f" || e.key === "F") {
      e.preventDefault(); toggleFullscreen();
    }
  });

})();
