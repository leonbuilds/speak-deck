# ============================================================
# TTS Provider 选择
# 可选: fish (Fish Audio) | qwen (阿里云千问TTS)
# ============================================================
TTS_PROVIDER=fish

# ============================================================
# Fish Audio（推荐：中文效果最好，已有声音克隆直接用）
# 注册：https://fish.audio/  → 右上角 API → 生成 API Key
# 声音 ID：克隆完成后在 My Voices 页面获取 reference_id，
#           存到 _voice/voice-id.txt（也可用社区音色 ID）
# ============================================================
FISH_AUDIO_API_KEY=

# ============================================================
# 阿里云千问TTS（备选：便宜，内置 40+ 中文音色）
# 注册：https://bailian.console.aliyun.com/
# → 右上角头像 → API-KEY → 创建
# 系统音色示例：Cherry（女）/ Neil（男播音）/ Ethan（男活力）
#               Serena（女温柔）/ Rocky（粤语）等 40+ 可选
# 自定义音色：克隆后写入 _voice/voice-id.qwen.txt
# ============================================================
DASHSCOPE_API_KEY=
QWEN_TTS_VOICE=Cherry

# ============================================================
# Fish Audio 代理（访问海外服务器用，填你 VPN 的本地 HTTP 端口）
# 常见值：Clash = http://127.0.0.1:7890  V2rayN = http://127.0.0.1:10809
# ============================================================
HTTPS_PROXY=

# ============================================================
# Qwen TTS 演讲风格（留空 = 默认内置演讲风格；填 plain = 纯读文本）
# 也可自定义：QWEN_TTS_STYLE="用沉稳新闻腔朗读，语速稍慢"
# ============================================================
QWEN_TTS_STYLE=

# ============================================================
# MiniMax（旧配置，保留兼容）
# ============================================================
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
